# dependencies
node_modules/
.pnpm-store/

# builds and their caches
dist/
.release/
*.tsbuildinfo

# from-source runs: their own state, projects and exports (`pnpm dev`, `pnpm dev:desktop`)
.dev/
# a working directory for probes and screenshots while investigating something: never part of the tree
.scratch/

# what a film's tools keep beside it
.film/

# local settings and secrets
.env*

# OS and editors
.DS_Store
*.log

# local namespace-lease experiment test roots (synthetic, never committed)
.local-test-lease-*/

# a Chromium profile that electron/playwright runs drop in the repo root (never source)
/Default/
/Local State
/Last Browser
/Last Version
/FirstLaunchAfterInstallation
/Ad Blocking/
/BrowserMetrics/
/Crashpad/
/GPUPersistentCache/
/GrShaderCache/
/ShaderCache/
/SmartScreen/
/Nurturing/
/component_crx_cache/
/Variations*

# the runtime ffmpeg the packager fetches (~210 MB, reproducible from ffmpeg-runtime.mjs)
apps/desktop/resources/
