{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orange/tag/1",
  "$comment": "每条标签必须带来源、证据与词表版本。没有 evidence 的标签一律拒收（不写库）。namespace=cloud 时 code 必须能在 ops.label_dictionary 里找到；local_facet 允许裸露，但不得冒充云标签。",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "code", "dimension", "source", "confidence", "evidence", "dictionaryVersion"],
  "properties": {
    "namespace": { "enum": ["cloud", "local_facet"] },
    "code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dimension": {
      "enum": ["category1", "category2", "label", "shot_size", "rhythm", "scene", "selling_point"]
    },
    "source": { "enum": ["supplier", "vlm", "asr", "computed", "human"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["frameAtMs"], "properties": { "frameAtMs": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["transcriptRangeMs"], "properties": { "transcriptRangeMs": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 } } },
        { "type": "object", "additionalProperties": false, "required": ["supplierField"], "properties": { "supplierField": { "type": "string", "minLength": 1 } } }
      ]
    },
    "dictionaryVersion": { "type": "integer", "minimum": 1 }
  }
}
