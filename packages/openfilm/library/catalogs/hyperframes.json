  {
   "id": "motions/hf-cover-rise",
   "cat": "transition",
   "group": "hyperframes",
   "name": {
    "en": "Cover rise",
    "zh-CN": "上盖",
    "ja": "カバーライズ",
    "ko": "덮어 올리기",
    "es": "Cubrir desde abajo"
   },
   "kind": "motion",
   "durationMs": 700,
   "place": "cut",
   "lap": true,
   "motion": {
    "in": {
     "name": "motion-cut-in-hf-cover-rise",
     "body": "from { translate: 0 100vh } to { translate: 0 0 }",
     "secs": 0.7,
     "ease": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "out": {
     "name": "motion-cut-out-hf-cover-rise",
     "body": " to { translate: 0 -12vh; scale: 0.94; filter: brightness(0.78) }",
     "secs": 0.7,
     "ease": "cubic-bezier(0.22, 1, 0.36, 1)"
    }
   },
   "about": "The next shot rises over the last one like a sheet while the last sinks back and darkens under it. For chapters, cards and reveals.",
   "tags": [
    "slide",
    "wipe",
    "transition"
   ]
  },
  {
   "id": "motions/hf-tilt-3d",
   "cat": "transition",
   "group": "hyperframes",
   "name": {
    "en": "Tilt, 3D",
    "zh-CN": "立体翻转",
    "ja": "3Dチルト",
    "ko": "3D 기울기",
    "es": "Inclinación 3D"
