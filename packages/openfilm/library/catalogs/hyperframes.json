   "kind": "motion",
   "durationMs": 700,
   "place": "cut",
   "lap": true,
   "motion": {
    "in": {
     "name": "motion-cut-in-hf-tilt-3d",
     "body": "from { rotate: x 72deg; opacity: 0 } to { rotate: x 0deg; opacity: 1 }",
     "secs": 0.7,
     "ease": "cubic-bezier(0.45, 0, 0.55, 1)"
    },
    "out": {
     "name": "motion-cut-out-hf-tilt-3d",
     "body": " to { rotate: x -72deg; opacity: 0 }",
     "secs": 0.7,
     "ease": "cubic-bezier(0.45, 0, 0.55, 1)"
    }
   },
   "about": "The picture tips away from the camera and the next one tips up into place, like a page on a table. For a change of scene with depth.",
