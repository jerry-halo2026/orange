<Project>
  <!-- Fission 全局编译属性（PRD §8.1 代码风格唯一事实源）。修改需过 PR 审查并同步 PRD。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 本机 Windows 19044 未打 CET 补丁：产物不要求 CET，避免运行时 FailFast（R8） -->
    <CETCompat>false</CETCompat>
    <!-- R8：SDK Roslyn apphost 在本机 CET FailFast，编译走 dotnet exec 转发壳（tools/csc-shim/csc.bat） -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <CscToolPath>$(MSBuildThisFileDirectory)tools\csc-shim</CscToolPath>
    <CscToolExe>csc.bat</CscToolExe>
    <!-- 暂缓规则白名单：每项必须带 issue 编号与解除条件（PRD §8.1）。当前为空。 -->
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>
</Project>
