{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orange:contracts:K07:desktop-startup:v1",
  "title": "K07.desktop-startup.v1",
  "description": "Single local desktop startup diagnostic record. Frame and sequence rules are implemented by the contract validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventName",
    "component",
    "timestamp",
    "traceId",
    "eventId",
    "environment",
    "appVersion",
    "buildCommit",
    "severity"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "eventName": {
      "enum": [
        "desktop.shell.start.begin",
        "desktop.shell.start.finish"
      ]
    },
    "component": {
      "const": "desktop.main"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z(?![\\s\\S])",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "pattern": "^(?!0{32}(?![\\s\\S]))[0-9a-f]{32}(?![\\s\\S])"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "environment": {
      "const": "local"
    },
    "appVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,8})(?:\\.(?:0|[1-9][0-9]{0,8})){2}(?![\\s\\S])"
    },
    "buildCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "severity": {
      "enum": [
        "info",
        "error"
      ]
    },
    "outcome": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errorCode": {
      "enum": [
        "SHELL_START_FAILED",
        "SHELL_LOAD_FAILED"
      ]
    }
  },
  "oneOf": [
    {
      "title": "begin",
      "required": [
        "schemaVersion",
        "eventName",
        "component",
        "timestamp",
        "traceId",
        "eventId",
        "environment",
        "appVersion",
        "buildCommit",
        "severity"
      ],
      "properties": {
        "eventName": {
          "const": "desktop.shell.start.begin"
        },
        "severity": {
          "const": "info"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "outcome"
            ]
          },
          {
            "required": [
              "durationMs"
            ]
          },
          {
            "required": [
              "errorCode"
            ]
          }
        ]
      }
    },
    {
      "title": "finishOk",
      "required": [
        "schemaVersion",
        "eventName",
        "component",
        "timestamp",
        "traceId",
        "eventId",
        "environment",
        "appVersion",
        "buildCommit",
        "severity",
        "outcome",
        "durationMs"
      ],
      "properties": {
        "eventName": {
          "const": "desktop.shell.start.finish"
        },
        "severity": {
          "const": "info"
        },
        "outcome": {
          "const": "ok"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "errorCode"
            ]
          }
        ]
      }
    },
    {
      "title": "finishFailed",
      "required": [
        "schemaVersion",
        "eventName",
        "component",
        "timestamp",
        "traceId",
        "eventId",
        "environment",
        "appVersion",
        "buildCommit",
        "severity",
        "outcome",
        "durationMs",
        "errorCode"
      ],
      "properties": {
        "eventName": {
          "const": "desktop.shell.start.finish"
        },
        "severity": {
          "const": "error"
        },
        "outcome": {
          "const": "failed"
        }
      }
    }
  ],
  "x-orange-k07": {
    "frame": {
      "maxLineBytes": 768,
      "maxRecords": 4,
      "eofDeadlineMs": 12000
    },
    "failure": {
      "startup": "SHELL_START_FAILED",
      "loadFile": "SHELL_LOAD_FAILED",
      "category": "system",
      "retryable": false
    },
    "errors": {
      "version": {
        "code": "CONTRACT_VERSION",
        "path": "$.schemaVersion"
      },
      "field": {
        "code": "CONTRACT_FIELD",
        "pathPrefix": "$."
      },
      "shape": {
        "code": "CONTRACT_SHAPE",
        "path": "$"
      },
      "frame": {
        "code": "DIAGNOSTIC_FRAME",
        "path": "$frame"
      },
      "conflict": {
        "code": "DIAGNOSTIC_CONFLICT",
        "path": "$stream"
      },
      "mismatch": {
        "code": "DIAGNOSTIC_MISMATCH",
        "path": "$stream"
      },
      "incomplete": {
        "code": "DIAGNOSTIC_INCOMPLETE",
        "path": "$stream"
      }
    }
  }
}
